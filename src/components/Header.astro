---
import { GITHUB_URL, SITE_TITLE } from '../consts'; import HeaderLink from './HeaderLink.astro';
const base=import.meta.env.BASE_URL.replace(/\/$/,''); const path=(value='')=>`${base}/${value}`;
---
<header><nav><a class="brand" href={path()}>{SITE_TITLE}</a><div class="links"><HeaderLink href={path()}>HOME</HeaderLink><HeaderLink href={path('projects')}>PROJECTS</HeaderLink><HeaderLink href={path('blog')}>NOTES</HeaderLink><HeaderLink href={path('about')}>ABOUT</HeaderLink></div><a class="github" href={GITHUB_URL}>GITHUB ↗</a></nav></header>
<style>header{background:var(--bg)}nav{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;max-width:1180px;height:78px;margin:auto;padding:0 32px;font-size:.62rem;font-weight:700;letter-spacing:.04em}a{color:#111;text-decoration:none}.brand{justify-self:start}.links{display:flex;gap:30px}.github{justify-self:end;border:1px solid #111;border-radius:99px;padding:6px 11px}@media(max-width:700px){nav{grid-template-columns:1fr auto;padding:0 16px}.links{gap:13px}.github{display:none}.brand{display:none}}</style>
