---
import { GITHUB_URL, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (value = '') => `${base}/${value}`;
---
<header>
	<nav aria-label="주요 메뉴">
		<a class="brand" href={path()}><span>●</span>{SITE_TITLE}</a>
		<div class="internal-links"><HeaderLink href={path()}>홈</HeaderLink><HeaderLink href={path('projects')}>프로젝트</HeaderLink><HeaderLink href={path('blog')}>인사이트</HeaderLink><HeaderLink href={path('about')}>소개</HeaderLink></div>
		<a class="github" href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub ↗</a>
	</nav>
</header>
<style>
header{position:sticky;top:0;z-index:10;border-bottom:1px solid var(--line);background:rgba(11,14,17,.86);backdrop-filter:blur(16px)}
nav{display:flex;align-items:center;justify-content:space-between;max-width:1120px;height:68px;margin:auto;padding:0 24px}nav a{color:var(--muted);text-decoration:none}.brand{color:var(--text);font-weight:700;letter-spacing:.06em}.brand span{color:var(--accent);margin-right:10px}.internal-links{display:flex;gap:28px}.internal-links a{padding:22px 2px 19px;border-bottom:2px solid transparent}.internal-links a:hover,.internal-links a.active{color:var(--text);border-color:var(--accent)}.github{font-size:.88rem;border:1px solid var(--line);border-radius:99px;padding:8px 14px}.github:hover{color:var(--text);border-color:var(--muted)}
@media(max-width:720px){nav{padding:0 16px}.github{display:none}.internal-links{gap:16px}}
</style>
