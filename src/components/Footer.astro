---
import { AUTHOR, GITHUB_URL } from '../consts';
const today = new Date();
---
<footer><div><span>BACKSPACE.DATA</span> 데이터를 관찰하고, 분석하고, 설명합니다.</div><div>© {today.getFullYear()} {AUTHOR} · <a href={GITHUB_URL}>GitHub</a> · <a href={`${import.meta.env.BASE_URL}rss.xml`}>RSS</a></div></footer>
<style>footer{max-width:1120px;margin:80px auto 0;padding:32px 24px 48px;border-top:1px solid var(--line);color:var(--muted);font-size:.9rem;display:flex;justify-content:space-between;gap:20px}span{color:var(--accent);font-size:.72rem;font-weight:700;letter-spacing:.08em;margin-right:8px}a{color:var(--muted)}@media(max-width:640px){footer{flex-direction:column}}</style>
