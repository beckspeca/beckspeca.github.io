---
import { AUTHOR, GITHUB_URL } from '../consts'; const year=new Date().getFullYear();
---
<footer><div class="statement">데이터를 관찰하고,<br/>분석하고, 설명합니다.</div><div class="nav"><span>EXPLORE</span><a href={`${import.meta.env.BASE_URL}`}>Home</a><a href={`${import.meta.env.BASE_URL}projects`}>Projects</a><a href={`${import.meta.env.BASE_URL}blog`}>Notes</a><a href={`${import.meta.env.BASE_URL}about`}>About</a></div><div class="connect"><span>CONNECT</span><a href="mailto:beckspeca@gmail.com">Email ↗</a><a href={GITHUB_URL}>GitHub ↗</a><a href={`${import.meta.env.BASE_URL}rss.xml`}>RSS ↗</a></div><div class="copy">© {year}<br/>{AUTHOR}</div></footer>
<style>footer{width:min(1180px,calc(100% - 64px));margin:100px auto 0;padding:45px 0 28px;border-top:1px solid #111;display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:40px;font-size:.75rem}.statement{font-size:1.5rem;line-height:1.1}.nav,.connect{display:flex;flex-direction:column}.nav span,.connect span{font-size:.58rem;font-weight:bold;margin-bottom:13px}.nav a,.connect a{color:#111;text-decoration:none}.copy{text-align:right;font-size:.65rem}@media(max-width:700px){footer{width:calc(100% - 32px);grid-template-columns:1fr 1fr;margin-top:60px}.statement{grid-column:1/-1}.copy{text-align:left}}</style>
