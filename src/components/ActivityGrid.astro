---
import { getCollection } from 'astro:content';
const posts=await getCollection('blog',({data})=>!data.draft); const today=new Date(); today.setHours(0,0,0,0); const start=new Date(today); start.setDate(today.getDate()-83-today.getDay());
const activity=new Map<string,{count:number;titles:string[]}>(); for(const post of posts){const key=post.data.pubDate.toISOString().slice(0,10);const item=activity.get(key)??{count:0,titles:[]};item.count++;item.titles.push(post.data.title);activity.set(key,item)}
const weeks=Array.from({length:12},(_,week)=>Array.from({length:7},(_,day)=>{const date=new Date(start);date.setDate(start.getDate()+week*7+day);const key=date.toISOString().slice(0,10);const item=activity.get(key);return{date,count:item?.count??0,titles:item?.titles??[],future:date>today}}));
const visibleCount=weeks.flat().reduce((sum,day)=>sum+day.count,0); const monthLabels=weeks.map((week,index)=>{const first=week.find(day=>day.date.getDate()<=7);return first||index===0?`${(first??week[0]).date.getMonth()+1}월`:''}); const formatDate=(date:Date)=>new Intl.DateTimeFormat('ko-KR',{month:'long',day:'numeric'}).format(date);
---
<section class="activity" aria-labelledby="activity-title"><div class="activity-intro"><p>ACTIVITY</p><h2 id="activity-title">Analysis<br/>Activity</h2><span>최근 12주 · {visibleCount}개의 분석 기록</span></div><div class="activity-chart"><div class="months" aria-hidden="true">{monthLabels.map(month=><span>{month}</span>)}</div><div class="chart-body"><div class="days" aria-hidden="true"><span>월</span><span>수</span><span>금</span></div><div class="grid">{weeks.map(week=><div class="week">{week.map(day=><span class:list={['cell',{active:day.count>0,future:day.future}]} title={`${formatDate(day.date)}${day.count?` · ${day.titles.join(', ')}`:' · 기록 없음'}`} aria-label={`${formatDate(day.date)}, ${day.count}개 기록`}></span>)}</div>)}</div></div><div class="legend"><span>적음</span><i></i><i class="filled"></i><span>많음</span></div></div></section>
<style>.activity{display:grid;grid-template-columns:1fr 1fr;gap:50px;padding:60px 0 100px;border-top:1px solid #111}.activity-intro>p{font-size:.62rem;font-weight:700;letter-spacing:.08em}.activity-intro h2{margin:35px 0 25px}.activity-intro>span{font-size:.78rem}.activity-chart{align-self:end}.months{display:grid;grid-template-columns:repeat(12,1fr);gap:5px;margin-left:29px;margin-bottom:7px}.months span{font-size:.58rem;color:#666}.chart-body{display:flex;gap:10px}.days{width:19px;display:grid;grid-template-rows:repeat(7,13px);gap:5px;font-size:.55rem;color:#666}.days span:nth-child(1){grid-row:2}.days span:nth-child(2){grid-row:4}.days span:nth-child(3){grid-row:6}.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:5px;flex:1}.week{display:grid;grid-template-rows:repeat(7,13px);gap:5px}.cell{display:block;width:100%;min-width:11px;border:1px solid #aaa;background:transparent}.cell.active{background:#222;border-color:#222}.cell.future{opacity:.25}.legend{display:flex;justify-content:flex-end;align-items:center;gap:6px;margin-top:13px;color:#666;font-size:.55rem}.legend i{width:12px;height:12px;border:1px solid #aaa}.legend i.filled{background:#222;border-color:#222}@media(max-width:700px){.activity{grid-template-columns:1fr}.activity-chart{overflow-x:auto;padding-bottom:8px}.months,.chart-body,.legend{min-width:490px}}</style>
