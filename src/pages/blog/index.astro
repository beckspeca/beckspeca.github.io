---
import { getCollection } from 'astro:content'; import BaseHead from '../../components/BaseHead.astro'; import Footer from '../../components/Footer.astro'; import FormattedDate from '../../components/FormattedDate.astro'; import Header from '../../components/Header.astro';
const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()); const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<!doctype html><html lang="ko"><head><BaseHead title="글 | JAEWON.LOG" description="개발하며 배우고 해결한 내용을 기록합니다."/></head><body><Header/><main><header class="page-head"><p class="eyebrow">Archive</p><h1>모든 글</h1><p>배움과 시행착오를 차곡차곡 쌓아가는 공간입니다. <span>{posts.length}개의 기록</span></p></header><section class="list">{posts.map(post=><article><time><FormattedDate date={post.data.pubDate}/></time><a href={`${base}/blog/${post.id}/`}><div class="tags">{post.data.tags.map(tag=><span>#{tag}</span>)}</div><h2>{post.data.title}</h2><p>{post.data.description}</p></a><span class="arrow">↗</span></article>)}</section></main><Footer/></body></html>
<style>.page-head{padding:55px 0 70px;border-bottom:1px solid var(--line)}.page-head h1{font-size:clamp(3rem,7vw,5rem)}.page-head p{color:var(--muted)}.page-head span{color:var(--accent)}.list article{position:relative;display:grid;grid-template-columns:150px 1fr 30px;gap:30px;padding:34px 10px;border-bottom:1px solid var(--line)}.list time{color:var(--muted);font-size:.85rem;padding-top:31px}.list a{color:var(--text);text-decoration:none}.list h2{font-size:1.65rem;margin:.25em 0}.list p{color:var(--muted);margin:0}.tags{color:var(--accent);font-size:.76rem}.tags span{margin-right:9px}.arrow{align-self:center;color:var(--muted);font-size:1.4rem}.list article:hover{background:linear-gradient(90deg,transparent,var(--surface),transparent)}.list article:hover .arrow{color:var(--accent)}@media(max-width:650px){.list article{grid-template-columns:1fr 24px;gap:8px}.list time{grid-column:1/-1;padding:0}.list h2{font-size:1.35rem}.arrow{grid-column:2;grid-row:2}}</style>
