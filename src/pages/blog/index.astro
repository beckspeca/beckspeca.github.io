---
import { getCollection } from 'astro:content'; import BaseHead from '../../components/BaseHead.astro'; import Footer from '../../components/Footer.astro'; import FormattedDate from '../../components/FormattedDate.astro'; import Header from '../../components/Header.astro';
const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()); const base=import.meta.env.BASE_URL.replace(/\/$/,''); const tags=[...new Set(posts.flatMap(post=>post.data.tags))];
---
<!doctype html><html lang="ko"><head><BaseHead title="인사이트 | JAEWON.DATA" description="데이터 분석 과정에서 배우고 발견한 내용을 기록합니다."/></head><body><Header/><main>
<header class="page-head"><div><p class="eyebrow">Analysis journal</p><h1>데이터 인사이트</h1><p>분석 도구의 사용법부터 프로젝트에서 발견한 패턴과 판단 과정까지 기록합니다.</p></div><div class="summary"><span><b>{String(posts.length).padStart(2,'0')}</b> Articles</span><span><b>{String(tags.length).padStart(2,'0')}</b> Topics</span></div></header>
<section class="filters"><span>ALL NOTES</span>{tags.map(tag=><span>#{tag}</span>)}</section>
<section class="list">{posts.map((post,index)=><article><div class="index">{String(index+1).padStart(2,'0')}</div><div class="meta"><time><FormattedDate date={post.data.pubDate}/></time><div>{post.data.tags.map(tag=><span>#{tag}</span>)}</div></div><a href={`${base}/blog/${post.id}/`}><h2>{post.data.title}</h2><p>{post.data.description}</p></a><a class="arrow" aria-label={`${post.data.title} 읽기`} href={`${base}/blog/${post.id}/`}>↗</a></article>)}</section>
</main><Footer/></body></html>
<style>.page-head{display:grid;grid-template-columns:1fr auto;align-items:end;gap:50px;padding:55px 0 75px;border-bottom:1px solid var(--line)}.page-head h1{font-size:clamp(3.2rem,8vw,6rem)}.page-head p:not(.eyebrow){max-width:650px;color:var(--muted)}.summary{display:flex;gap:30px;padding-bottom:12px}.summary span{color:var(--muted);font-size:.7rem;text-transform:uppercase;letter-spacing:.1em}.summary b{display:block;color:var(--accent);font-size:1.8rem;line-height:1}.filters{display:flex;flex-wrap:wrap;gap:10px;padding:24px 0;border-bottom:1px solid var(--line)}.filters span{padding:5px 10px;border:1px solid var(--line);border-radius:4px;color:var(--muted);font-size:.68rem}.filters span:first-child{color:var(--text);background:var(--surface-2)}.list article{display:grid;grid-template-columns:55px 160px 1fr 35px;align-items:center;gap:22px;padding:34px 10px;border-bottom:1px solid var(--line);transition:.2s}.list article:hover{background:linear-gradient(90deg,transparent,var(--surface),transparent)}.index{color:#53657b;font-size:.75rem}.meta time{display:block;color:var(--muted);font-size:.76rem;margin-bottom:9px}.meta div{display:flex;flex-wrap:wrap;gap:6px}.meta span{color:var(--accent-2);font-size:.66rem}.list a{color:var(--text);text-decoration:none}.list h2{font-size:1.65rem;margin:0 0 .3em}.list p{color:var(--muted);font-size:.88rem;margin:0;max-width:650px}.arrow{font-size:1.4rem;color:var(--accent)!important}@media(max-width:720px){.page-head{grid-template-columns:1fr}.summary{padding:0}.list article{grid-template-columns:35px 1fr 24px}.meta{grid-column:2}.list article>a:not(.arrow){grid-column:2}.arrow{grid-column:3;grid-row:2/4}.list h2{font-size:1.3rem}}</style>
