---
import { getCollection } from 'astro:content'; import BaseHead from '../components/BaseHead.astro'; import Footer from '../components/Footer.astro'; import FormattedDate from '../components/FormattedDate.astro'; import Header from '../components/Header.astro'; import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
const base=import.meta.env.BASE_URL.replace(/\/$/,''); const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,3);
---
<!doctype html><html lang="ko"><head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION}/></head><body><Header/><main>
<section class="hero"><div class="hero-copy"><p class="eyebrow">Data Analyst Portfolio</p><h1>데이터에서<br/><span>의미를 찾습니다.</span></h1><p>모호한 질문을 분석 가능한 문제로 바꾸고,<br/>데이터에 근거한 인사이트를 명확하게 전달합니다.</p><div class="actions"><a class="primary" href={`${base}/projects`}>프로젝트 보기 →</a><a class="secondary" href={`${base}/about`}>분석가 소개</a></div><div class="tools"><b>TOOLS</b><span>Python</span><span>SQL</span><span>Pandas</span><span>Visualization</span></div></div>
<div class="dashboard"><div class="dash-head"><div><small>ANALYSIS WORKFLOW</small><strong>From question to insight</strong></div><span>● ACTIVE</span></div><div class="chart"><div class="bars"><i></i><i></i><i></i><i></i><i></i></div><svg viewBox="0 0 500 150" preserveAspectRatio="none"><polyline points="10,126 125,100 250,108 375,50 490,24"/></svg></div><div class="steps"><span><b>01</b>질문 정의</span><span><b>02</b>데이터 정제</span><span><b>03</b>탐색·검증</span><span><b>04</b>시각화</span></div></div></section>
<section class="projects"><div class="section-head"><div><p class="eyebrow">Selected projects</p><h2>데이터로 답한 질문</h2></div><a href={`${base}/projects`}>전체 프로젝트 →</a></div><div class="project-grid"><a href={`${base}/projects#mobility`} class="project main-project"><div class="project-top"><span>01 · Urban Mobility</span><b>Python · Pandas</b></div><h3>서울 지하철 승하차량과<br/>따릉이 이용량 관계 분석</h3><p>서로 다른 교통 데이터를 역 단위로 결합해 도시 이동 패턴의 관계를 탐색했습니다.</p><div class="mini-chart"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><strong>Case study 보기 ↗</strong></a><a href={`${base}/projects#process`} class="project process"><span>ANALYSIS PRINCIPLE</span><h3>숫자보다 먼저<br/>질문을 정의합니다.</h3><ol><li>문제와 가설 설정</li><li>데이터 품질 확인</li><li>분석 결과 검증</li><li>의사결정 언어로 전달</li></ol></a></div></section>
<section class="latest"><div class="section-head"><div><p class="eyebrow">Analysis notes</p><h2>최근 인사이트</h2></div><a href={`${base}/blog`}>모든 글 →</a></div><div class="post-list">{posts.map(post=><a href={`${base}/blog/${post.id}/`}><time><FormattedDate date={post.data.pubDate}/></time><div><div>{post.data.tags.map(tag=><span>#{tag}</span>)}</div><h3>{post.data.title}</h3><p>{post.data.description}</p></div><b>↗</b></a>)}</div></section>
</main><Footer/></body></html>
<style>
.hero{min-height:70vh;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:70px;padding:36px 0 110px}.hero h1{font-size:clamp(3.3rem,7vw,6.2rem);margin:.1em 0 .25em}.hero h1 span{color:var(--accent)}.hero-copy>p:not(.eyebrow){color:var(--muted);font-size:1.08rem}.actions{display:flex;gap:12px;margin:32px 0}.actions a{padding:12px 19px;border-radius:7px;text-decoration:none;font-weight:700}.primary{background:var(--accent);color:#071221}.secondary{border:1px solid var(--line);color:var(--text)}.tools{display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-size:.76rem;color:var(--muted)}.tools b{font-size:.66rem;letter-spacing:.14em;margin-right:8px}.tools span{padding:4px 9px;border:1px solid var(--line);border-radius:4px}.dashboard{border:1px solid var(--line);border-radius:16px;background:linear-gradient(145deg,rgba(19,35,58,.95),rgba(9,19,33,.96));padding:25px;box-shadow:0 30px 100px rgba(0,0,0,.28)}.dash-head{display:flex;justify-content:space-between}.dash-head small{display:block;color:var(--muted);font-size:.62rem;letter-spacing:.14em}.dash-head strong{display:block;font-size:1.15rem}.dash-head>span{color:var(--accent-2);font-size:.65rem}.chart{height:230px;position:relative;margin:25px 0 20px;border-left:1px solid var(--line);border-bottom:1px solid var(--line);background:repeating-linear-gradient(0deg,transparent,transparent 49px,var(--line) 50px)}.bars{position:absolute;inset:0;display:flex;justify-content:space-around;align-items:end;padding:0 25px}.bars i{width:34px;background:linear-gradient(var(--accent),rgba(98,168,255,.15));border-radius:5px 5px 0 0;opacity:.45}.bars i:nth-child(1){height:38%}.bars i:nth-child(2){height:53%}.bars i:nth-child(3){height:48%}.bars i:nth-child(4){height:78%}.bars i:nth-child(5){height:92%}.chart svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}.chart polyline{fill:none;stroke:var(--accent-2);stroke-width:3;vector-effect:non-scaling-stroke}.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.steps span{font-size:.67rem;color:var(--muted)}.steps b{display:block;color:var(--accent);font-size:.6rem}.projects,.latest{padding:82px 0;border-top:1px solid var(--line)}.section-head{display:flex;align-items:end;justify-content:space-between;margin-bottom:32px}.section-head h2{margin:0}.section-head a{text-decoration:none;font-size:.88rem}.project-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:18px}.project{display:block;min-height:410px;border:1px solid var(--line);border-radius:14px;background:var(--surface);padding:30px;color:var(--text);text-decoration:none}.project-top{display:flex;justify-content:space-between;color:var(--accent);font-size:.7rem}.project-top b{color:var(--muted)}.project h3{font-size:clamp(1.6rem,3vw,2.35rem);margin-top:60px}.project p{color:var(--muted);max-width:580px}.mini-chart{height:90px;display:flex;align-items:end;gap:9px;margin:25px 0}.mini-chart i{flex:1;background:var(--accent);opacity:.2;border-radius:3px 3px 0 0}.mini-chart i:nth-child(1){height:30%}.mini-chart i:nth-child(2){height:50%}.mini-chart i:nth-child(3){height:42%}.mini-chart i:nth-child(4){height:78%}.mini-chart i:nth-child(5){height:60%}.mini-chart i:nth-child(6){height:88%}.mini-chart i:nth-child(7){height:70%}.main-project>strong{font-size:.82rem;color:var(--accent)}.process{background:linear-gradient(150deg,#122946,#0d1a2c)}.process>span{font-size:.65rem;color:var(--accent-2)}.process h3{font-size:1.75rem}.process ol{padding:0;list-style:none;counter-reset:item}.process li{counter-increment:item;padding:11px 0;border-bottom:1px solid var(--line);color:var(--muted);font-size:.85rem}.process li:before{content:'0' counter(item);color:var(--accent);margin-right:15px}.post-list>a{display:grid;grid-template-columns:140px 1fr 30px;gap:25px;padding:25px 8px;border-bottom:1px solid var(--line);color:var(--text);text-decoration:none}.post-list time,.post-list p{color:var(--muted);font-size:.82rem}.post-list h3{margin:.25em 0}.post-list p{margin:0}.post-list div div{color:var(--accent);font-size:.7rem}.post-list div div span{margin-right:7px}@media(max-width:850px){.hero{grid-template-columns:1fr}.project-grid{grid-template-columns:1fr}.dashboard{max-width:620px}.steps{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.hero{padding-bottom:70px}.hero br{display:none}.project{min-height:auto}.project-top{flex-direction:column}.post-list>a{grid-template-columns:1fr 24px}.post-list time{grid-column:1/-1}}
</style>
