---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { AUTHOR, GITHUB_URL } from '../consts';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`소개 | BACKSPACE.DATA`} description={`데이터 분석가 ${AUTHOR}의 소개`} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<div class="label"><span>ABOUT</span><b>01</b></div>
				<div class="headline">
					<p class="eyebrow">Data Analyst</p>
					<h1>데이터 속에서<br /><em>의도와 법칙을 찾는</em><br />분석가 신재원입니다.</h1>
				</div>
			</section>

			<section class="profile">
				<div class="profile-label"><span>PROFILE</span><b>데이터를 관찰하고 질문합니다.</b></div>
				<div class="profile-copy">
					<p>흩어진 데이터에서 의미 있는 패턴을 발견하고, 분석 결과를 이해하기 쉬운 근거로 전달하는 데이터 분석가를 목표로 합니다.</p>
					<p>도구를 사용하는 것에 그치지 않고 데이터가 무엇을 말하는지, 그 결과가 어떤 의사결정으로 이어질 수 있는지 고민합니다.</p>
				</div>
			</section>

			<section class="tool-section">
				<div class="section-title"><p class="eyebrow">Toolkit</p><h2>사용 가능한 도구</h2></div>
				<div class="tool-grid">
					<article><b>01</b><div><h3>Python</h3><p>데이터 처리와 분석</p></div></article>
					<article><b>02</b><div><h3>SQL</h3><p>데이터 조회와 집계</p></div></article>
					<article><b>03</b><div><h3>Pandas</h3><p>데이터 정제와 탐색</p></div></article>
					<article><b>04</b><div><h3>NumPy</h3><p>수치 연산과 배열 처리</p></div></article>
				</div>
			</section>

			<section class="contact">
				<div><p class="eyebrow">Contact</p><h2>함께 이야기해요.</h2></div>
				<div class="contact-links">
					<a href="mailto:beckspeca@gmail.com"><span>Email</span><strong>beckspeca@gmail.com</strong><b>↗</b></a>
					<a href={GITHUB_URL} target="_blank" rel="noreferrer"><span>GitHub</span><strong>github.com/beckspeca</strong><b>↗</b></a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro{display:grid;grid-template-columns:130px 1fr;gap:35px;padding:55px 0 100px}.label{display:flex;flex-direction:column;justify-content:space-between;color:var(--muted);font-size:.65rem;letter-spacing:.14em}.label b{color:var(--accent);font-size:2rem;font-weight:400}.headline h1{font-size:clamp(3rem,7vw,6rem);margin:.2em 0 0}.headline em{color:var(--accent);font-style:normal}.profile{display:grid;grid-template-columns:1fr 1.6fr;gap:80px;padding:70px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.profile-label span{display:block;color:var(--accent-2);font-size:.68rem;letter-spacing:.14em}.profile-label b{display:block;margin-top:18px;font-size:1.25rem}.profile-copy{color:#b4c4d8;font-size:1.06rem;max-width:680px}.profile-copy p:last-child{margin-bottom:0}.tool-section{padding:80px 0}.section-title{margin-bottom:34px}.section-title h2{margin:0}.tool-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.tool-grid article{display:flex;align-items:center;gap:25px;padding:24px;border:1px solid var(--line);border-radius:10px;background:var(--surface)}.tool-grid article>b{color:var(--accent);font-size:.7rem}.tool-grid h3{margin:0;font-size:1.25rem}.tool-grid p{margin:2px 0 0;color:var(--muted);font-size:.8rem}.contact{display:grid;grid-template-columns:.75fr 1.25fr;gap:60px;padding:75px 0;border-top:1px solid var(--line)}.contact h2{margin:0}.contact-links a{display:grid;grid-template-columns:80px 1fr 20px;align-items:center;gap:15px;padding:18px 5px;border-bottom:1px solid var(--line);color:var(--text);text-decoration:none}.contact-links span{color:var(--muted);font-size:.7rem;text-transform:uppercase;letter-spacing:.1em}.contact-links strong{font-weight:400}.contact-links b{color:var(--accent)}.contact-links a:hover strong{color:var(--accent)}
	@media(max-width:760px){.intro{grid-template-columns:1fr;padding-bottom:70px}.label{display:none}.profile,.contact{grid-template-columns:1fr;gap:30px}.tool-grid{grid-template-columns:1fr}.contact-links a{grid-template-columns:65px 1fr 20px}.contact-links strong{font-size:.88rem}}
</style>
